<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.clementherve.intellijjavadependencyupdaterplugin</id>
    <name>Gradle Dependency Updater</name>
    <vendor>clementherve</vendor>
    <description><![CDATA[
        <p><b>Gradle Dependency Updater</b> helps you keep your Gradle dependencies up to date.</p>
        <p>Features:</p>
        <ul>
            <li>Automatic detection of outdated dependencies in build.gradle and build.gradle.kts files</li>
            <li>Visual gutter icons indicating available updates</li>
            <li>Alt+Enter quick-fix intentions to update dependencies</li>
            <li>Configurable version policies (stable only, include/exclude patterns)</li>
            <li>Support for Maven Central and private Nexus repositories</li>
            <li>Smart caching to minimize network requests</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.groovy</depends>
    <!-- Make Kotlin plugin optional for K2 compatibility -->
    <depends optional="true" config-file="kotlin-support.xml">org.jetbrains.kotlin</depends>

    <resource-bundle>messages.DependencyUpdaterBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings -->
        <projectConfigurable
                parentId="tools"
                instance="com.github.clementherve.intellijjavadependencyupdaterplugin.settings.DependencyUpdaterConfigurable"
                id="tools.dependency.updater"
                displayName="Dependency Updater"/>
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.settings.DependencyUpdaterSettings"/>

        <!-- Services -->
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.cache.VersionCache"/>
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.services.DependencyUpdateService"/>

        <!-- Inline hints via annotator -->
        <annotator
                language="Groovy"
                implementationClass="com.github.clementherve.intellijjavadependencyupdaterplugin.annotator.DependencyAnnotator"/>

        <!-- Intentions -->
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToPatchIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMinorIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMajorIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
    </extensions>
</idea-plugin>
