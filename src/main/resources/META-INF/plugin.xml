<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.clementherve.intellijjavadependencyupdaterplugin</id>
    <name>Gradle Dependency Updater</name>
    <vendor>clementherve</vendor>
    <description><![CDATA[
        <p><b>Gradle Dependency Updater</b> helps you keep your Gradle dependencies up to date.</p>
        <p>Features:</p>
        <ul>
            <li>Automatic detection of outdated dependencies in build.gradle files</li>
            <li>Alt+Enter quick-fix intentions to update dependencies</li>
            <li>Configurable version policies</li>
            <li>Support for Maven Central and private Nexus repository</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.groovy</depends>

    <resource-bundle>messages.DependencyUpdaterBundle</resource-bundle>

    <!-- Startup activity for cache warming -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.clementherve.intellijjavadependencyupdaterplugin.startup.DependencyStartupActivity"/>
    </extensions>

    <!-- File change listener for ON_SAVE trigger mode -->
    <projectListeners>
        <listener class="com.github.clementherve.intellijjavadependencyupdaterplugin.listeners.BuildFileChangeListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings -->
        <projectConfigurable
                parentId="tools"
                instance="com.github.clementherve.intellijjavadependencyupdaterplugin.settings.DependencyUpdaterConfigurable"
                id="tools.dependency.updater"
                displayName="Dependency Updater"/>
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.settings.DependencyUpdaterSettings"/>

        <!-- Services -->
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.cache.VersionCache"/>
        <projectService
                serviceImplementation="com.github.clementherve.intellijjavadependencyupdaterplugin.services.DependencyUpdateService"/>

        <!-- Inline hints via annotator -->
        <annotator
                language="Groovy"
                implementationClass="com.github.clementherve.intellijjavadependencyupdaterplugin.annotator.DependencyAnnotator"/>

        <!-- Tool window -->
        <toolWindow id="Gradle Dependency Updater"
                    anchor="bottom"
                    icon="/dependency-icon.svg"
                    factoryClass="com.github.clementherve.intellijjavadependencyupdaterplugin.toolwindow.DependencyOverviewToolWindowFactory"/>

        <!-- Actions -->
        <action id="DependencyUpdater.UpdateAll"
                class="com.github.clementherve.intellijjavadependencyupdaterplugin.actions.UpdateAllDependenciesAction"
                text="Update All Dependencies"
                description="Update all outdated dependencies to their latest versions"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
        </action>

        <!-- Intentions -->
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToPatchIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMinorIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
        <intentionAction>
            <language>Groovy</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMajorIntention</className>
            <category>Dependency Updater</category>
        </intentionAction>
    </extensions>
</idea-plugin>
