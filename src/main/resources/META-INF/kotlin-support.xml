<idea-plugin>
    <!-- Kotlin DSL support - loaded when Kotlin plugin is available -->
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="com.github.clementherve.intellijjavadependencyupdaterplugin.marker.DependencyLineMarkerProvider"/>
        <annotator
                language="kotlin"
                implementationClass="com.github.clementherve.intellijjavadependencyupdaterplugin.annotator.DependencyAnnotator"/>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyIntention</className>
            <category>Dependency updater</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToPatchIntention</className>
            <category>Dependency updater</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMinorIntention</className>
            <category>Dependency updater</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.clementherve.intellijjavadependencyupdaterplugin.intention.UpdateDependencyToMajorIntention</className>
            <category>Dependency updater</category>
        </intentionAction>
    </extensions>
</idea-plugin>
